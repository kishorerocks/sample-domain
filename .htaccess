# .htaccess - Clean URLs & Production Configuration for KK LifeWise PHP Website
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Content URL Mappings (Clean Slugs)
    # Story Episode URLs: /stories/story-slug/episode-01/
    RewriteRule ^stories/([^/]+)/([^/]+)/?$ story-detail.php?slug=$1&episode=$2 [L,QSA]

    # Single Story URLs: /stories/story-slug/
    RewriteRule ^stories/([^/]+)/?$ story-detail.php?slug=$1 [L,QSA]

    # Single Book URLs: /books/book-slug/
    RewriteRule ^books/([^/]+)/?$ book-detail.php?slug=$1 [L,QSA]

    # Single Video URLs: /videos/video-slug/
    RewriteRule ^videos/([^/]+)/?$ video-detail.php?slug=$1 [L,QSA]

    # Single PDF URLs: /pdfs/pdf-slug/
    RewriteRule ^pdfs/([^/]+)/?$ pdf-detail.php?slug=$1 [L,QSA]

    # Category Article URLs: /motivation/article-slug/, /money/article-slug/, /career/article-slug/
    RewriteRule ^motivation/([^/]+)/?$ article.php?category=motivation&slug=$1 [L,QSA]
    RewriteRule ^money/([^/]+)/?$ article.php?category=money&slug=$1 [L,QSA]
    RewriteRule ^career/([^/]+)/?$ article.php?category=career&slug=$1 [L,QSA]

    # Main Section Clean URLs
    RewriteRule ^motivation/?$ motivation.php [L,QSA]
    RewriteRule ^money/?$ money.php [L,QSA]
    RewriteRule ^career/?$ career.php [L,QSA]
    RewriteRule ^stories/?$ stories.php [L,QSA]
    RewriteRule ^books/?$ books.php [L,QSA]
    RewriteRule ^videos/?$ videos.php [L,QSA]
    RewriteRule ^pdfs/?$ pdfs.php [L,QSA]
    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^assessment/?$ assessment.php [L,QSA]
    RewriteRule ^search/?$ search.php [L,QSA]

    # If physical file or folder exists, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Handle standard extension-less PHP URLs
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

# Security & Performance Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# GZIP Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
